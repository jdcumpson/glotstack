{
  "exclude": ["node_modules", "dist"],
  "include": ["./src/**/*", "types/**/*"],
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "esnext",
    "module": "CommonJS",
    "declaration": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "jsx": "react",
    "sourceMap": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true
  }
}
